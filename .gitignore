# Python bytecode and test/tool caches
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Virtual environments
.venv/
venv/
env/
.env/
.env.*
!.env.example

# Local editor and operating-system files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Logs and generated application files
*.log
/output/*
!/output/.gitkeep
/temp/*
!/temp/.gitkeep
/runtime-data/*.json
!/runtime-data/.gitkeep